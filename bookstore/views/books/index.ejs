<%- include('../partials/header') %>

<h4 class="mb-3">Dashboard</h4>

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row mb-4">
    <div class="col-md-4 mb-2">
        <div class="card border">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Books (Titles)</h6>
                <h3><%= totalBooks %></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Quantity in Stock</h6>
                <h3><%= totalQuantity %></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border">
            <div class="card-body">
                <h6 class="card-title text-muted">Total Inventory Value</h6>
                <h3>₹<%= totalValue.toFixed(2) %></h3>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">All Books</h5>
    <a href="/books/add" class="btn btn-primary btn-sm">+ Add New Book</a>
</div>

<% if (books.length === 0) { %>
    <div class="alert alert-info">No books found. <a href="/books/add">Add one now</a>.</div>
<% } else { %>

<div class="row">
    <% books.forEach(book => { %>
    <div class="col-md-4 col-sm-6 mb-4">
        <div class="card border h-100">
            <% if (book.image) { %>
                <img src="/uploads/<%= book.image %>" class="card-img-top book-img" alt="<%= book.title %>">
            <% } else { %>
                <div class="no-image-box text-center text-muted d-flex align-items-center justify-content-center">
                    <span>No Image</span>
                </div>
            <% } %>

            <div class="card-body">
                <h6 class="card-title mb-1"><%= book.title %></h6>
                <p class="card-text text-muted mb-1" style="font-size:13px;">by <%= book.author %></p>
                <span class="badge bg-secondary mb-2"><%= book.category %></span>
                <div class="d-flex justify-content-between">
                    <span><strong>₹<%= book.price %></strong></span>
                    <span class="text-muted" style="font-size:13px;">Qty: <%= book.quantity %></span>
                </div>
            </div>

            <div class="card-footer bg-white border-top">
                <div class="btn-group w-100" role="group">
                    <a href="/books/detail/<%= book._id %>" class="btn btn-sm btn-outline-secondary">View</a>
                    <a href="/books/edit/<%= book._id %>" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/books/delete/<%= book._id %>?_method=DELETE" method="POST" class="d-inline w-100">
                        <button type="submit" class="btn btn-sm btn-danger w-100"
                            onclick="return confirm('Are you sure you want to delete this book?')">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <% }) %>
</div>

<% } %>

<%- include('../partials/footer') %>
