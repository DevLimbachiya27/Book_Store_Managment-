<%- include('../partials/header') %>

<div class="row">
    <div class="col-md-8">
        <h5 class="mb-3">Edit Book</h5>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="card border">
            <div class="card-body">
                <form action="/books/edit/<%= book._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label">Book Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="<%= book.title %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Author <span class="text-danger">*</span></label>
                        <input type="text" name="author" class="form-control" value="<%= book.author %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <select name="category" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            <% const cats = ['Fiction','Non-Fiction','Science','Technology','History','Biography','Children','Comics','Self-Help','Other']; %>
                            <% cats.forEach(cat => { %>
                                <option value="<%= cat %>" <%= book.category === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" name="price" class="form-control" value="<%= book.price %>" min="0" step="0.01" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Quantity <span class="text-danger">*</span></label>
                            <input type="number" name="quantity" class="form-control" value="<%= book.quantity %>" min="0" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3"><%= book.description %></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Book Cover Image</label>
                        <% if (book.image) { %>
                            <div class="mb-2">
                                <small class="text-muted">Current image:</small><br>
                                <img src="/uploads/<%= book.image %>" alt="Current cover" style="height:80px; object-fit:cover; border:1px solid #ddd;">
                            </div>
                        <% } %>
                        <input type="file" name="image" class="form-control" accept="image/*">
                        <div class="form-text">Upload new image only if you want to change it.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Update Book</button>
                        <a href="/books" class="btn btn-secondary">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border">
            <div class="card-header bg-light">
                <strong>Book Info</strong>
            </div>
            <div class="card-body" style="font-size:13px;">
                <p class="mb-1"><strong>ID:</strong> <span class="text-muted"><%= book._id %></span></p>
                <p class="mb-1"><strong>Added:</strong> <%= book.createdAt.toDateString() %></p>
                <p class="mb-0"><strong>Last Updated:</strong> <%= book.updatedAt.toDateString() %></p>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
