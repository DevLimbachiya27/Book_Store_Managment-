<%- include('../partials/header') %>

<div class="row">
    <div class="col-md-4 mb-3">
        <% if (book.image) { %>
            <img src="/uploads/<%= book.image %>" class="img-fluid border" alt="<%= book.title %>" style="max-height:300px; object-fit:cover; width:100%;">
        <% } else { %>
            <div class="border text-center text-muted d-flex align-items-center justify-content-center" style="height:200px; background:#f8f9fa;">
                No Image Available
            </div>
        <% } %>
    </div>

    <div class="col-md-8">
        <h4><%= book.title %></h4>
        <p class="text-muted">by <strong><%= book.author %></strong></p>

        <table class="table table-bordered table-sm">
            <tr>
                <th style="width:35%">Category</th>
                <td><%= book.category %></td>
            </tr>
            <tr>
                <th>Price</th>
                <td>₹<%= book.price %></td>
            </tr>
            <tr>
                <th>Quantity in Stock</th>
                <td><%= book.quantity %></td>
            </tr>
            <tr>
                <th>Added On</th>
                <td><%= book.createdAt.toDateString() %></td>
            </tr>
            <tr>
                <th>Last Updated</th>
                <td><%= book.updatedAt.toDateString() %></td>
            </tr>
        </table>

        <% if (book.description) { %>
            <div class="mt-2">
                <strong>Description:</strong>
                <p class="mt-1"><%= book.description %></p>
            </div>
        <% } %>

        <div class="d-flex gap-2 mt-3">
            <a href="/books/edit/<%= book._id %>" class="btn btn-warning btn-sm">Edit Book</a>
            <a href="/books" class="btn btn-secondary btn-sm">Back to List</a>
            <form action="/books/delete/<%= book._id %>?_method=DELETE" method="POST" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm"
                    onclick="return confirm('Delete this book permanently?')">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
